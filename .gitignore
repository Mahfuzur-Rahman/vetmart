# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output
.next/
out/
build/
dist/

# Environment Files (Keep secrets safe!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# DO NOT ignore .env.example
!.env.example

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Vercel & Turbopack
.vercel
.turbo

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Logs & Debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
