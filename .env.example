# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/vetmart
DB_POOL_MAX=20

# Drivers (§4.3)
STORAGE_DRIVER=local
QUEUE_DRIVER=pg-cron
PDF_DRIVER=html-print
COURIER_DRIVER=mock
SMS_DRIVER=mock
PAYMENT_MODE=sandbox

# Demo
DEMO_MODE=true
NODE_ENV=development

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-me-in-production
JWT_SECRET=dev-jwt-secret-change-me-in-production
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Valkey / Redis
VALKEY_URL=redis://localhost:6379

# Cloudinary (demo only — leave blank for local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Steadfast (production only — leave blank for mock)
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=

# SMS
SMS_API_KEY=
SMS_SENDER_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
JOBS_DRAIN_SECRET=dev-drain-secret

# ---------------------------------------------------------------------------
# Vercel deploy (demo / sandbox) — set these in the Vercel project settings.
# lib/env.ts rejects the deploy at boot if any of them is wrong (§4.2, §4.3).
#
#   DATABASE_URL=postgresql://<user>:<pass>@<aiven-host>:<port>/defaultdb?sslmode=require
#                ^ MUST be the Aiven *pooled* (PgBouncer) port, not the direct one.
#                  A localhost URL here is rejected: a lambda has no local Postgres.
#   DB_POOL_MAX=1                 # a normal pool exhausts Aiven's connection cap
#   DEMO_MODE=false               # true = serve seed data, never touch the DB
#   STORAGE_DRIVER=cloudinary     # 'local' is rejected: Vercel's disk is read-only
#   CLOUDINARY_CLOUD_NAME=...     # required whenever STORAGE_DRIVER=cloudinary
#   CLOUDINARY_API_KEY=...
#   CLOUDINARY_API_SECRET=...
#   JOBS_DRAIN_SECRET=...         # protects /api/internal/jobs/tick
#   NEXT_PUBLIC_APP_URL=https://<your-deployment>.vercel.app
#
# Run migrations and seed once from a local shell, never at cold start:
#   DATABASE_URL='<aiven-pooled-url>' pnpm db:migrate
#   DATABASE_URL='<aiven-pooled-url>' pnpm db:seed
# ---------------------------------------------------------------------------
