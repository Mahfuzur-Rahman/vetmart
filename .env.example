# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/vetmart
DB_POOL_MAX=20

# Drivers (§4.3)
STORAGE_DRIVER=local
QUEUE_DRIVER=pg-cron
PDF_DRIVER=html-print
COURIER_DRIVER=mock
SMS_DRIVER=mock
PAYMENT_MODE=sandbox

# Demo
DEMO_MODE=true
NODE_ENV=development

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-me-in-production
JWT_SECRET=dev-jwt-secret-change-me-in-production
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Valkey / Redis
VALKEY_URL=redis://localhost:6379

# Cloudinary (demo only — leave blank for local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Steadfast (production only — leave blank for mock)
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=

# SMS
SMS_API_KEY=
SMS_SENDER_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
JOBS_DRAIN_SECRET=dev-drain-secret
